# Copy to .env for local testing:  cp .env.example .env
# In GitHub Actions these are provided by the repo Secret/Variable instead.

# --- Required -----------------------------------------------------------------
# Fine-grained personal access token (see README for the minimal permissions).
GH_PAT=github_pat_xxxxxxxxxxxxxxxxxxxxxx
# The GitHub account to mirror followers for (usually your own username).
TARGET_USERNAME=your-github-username

# --- Optional overrides (defaults shown) --------------------------------------
# Seconds to pause between follow / star write calls.
# STARGIVER_FOLLOW_DELAY=0.5
# STARGIVER_STAR_DELAY=0.3
# Per-request timeout in seconds and max transient-error retries.
# STARGIVER_REQUEST_TIMEOUT=10
# STARGIVER_MAX_RETRIES=3
# Override the API base (e.g. for GitHub Enterprise). Actions sets this for you.
# GITHUB_API_URL=https://api.github.com
